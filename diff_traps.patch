--- a/kernel/riscv.h
+++ b/kernel/riscv.h
@@ -1,5 +1,14 @@
 #ifndef __ASSEMBLER__
 
+static inline uint64
+r_fp()
+{
+  uint64 x;
+  // Inline assembly: move content of s0 to variable x
+  asm volatile("mv %0, s0" : "=r" (x));
+  return x;
+}
